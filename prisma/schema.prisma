model Conversation {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @db.Uuid
  patientId              String?             @db.Uuid
  leadId                 String?             @db.Uuid
  integrationId          String?             @db.Uuid
  channel                ConversationChannel
  status                 ConversationStatus  @default(OPEN)
  externalConversationId String?
  lastMessageAt          DateTime?           @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  tenant                 Tenant              @relation(fields: [tenantId], references: [id])
  patient                Patient?            @relation(fields: [patientId], references: [id])
  lead                   Lead?               @relation(fields: [leadId], references: [id])
  integration            Integration?        @relation(fields: [integrationId], references: [id])
  messages               Message[]

  @@unique([id, tenantId])
  @@unique([tenantId, integrationId, externalConversationId])
  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  conversationId      String           @db.Uuid
  direction           MessageDirection
  status              MessageStatus
  externalMessageId   String?
  contentType         String
  bodyCiphertext      String?
  bodyPreviewRedacted String?
  metadata            Json?
  sentAt              DateTime?        @db.Timestamptz(3)
  deliveredAt         DateTime?        @db.Timestamptz(3)
  readAt              DateTime?        @db.Timestamptz(3)
  failedAt            DateTime?        @db.Timestamptz(3)
  attempts            Int              @default(0)
  nextAttemptAt       DateTime?        @db.Timestamptz(3)
  processingStartedAt DateTime?        @db.Timestamptz(3)
  lastErrorCode       String?
  correlationId       String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  conversation        Conversation     @relation(fields: [conversationId], references: [id])

  @@unique([id, tenantId])
  @@unique([tenantId, conversationId, externalMessageId])
  @@index([tenantId, conversationId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([tenantId, direction, status, nextAttemptAt])
}

model Integration {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  provider            IntegrationProvider
  status              IntegrationStatus   @default(DISCONNECTED)
  externalAccountId   String?
  credentialReference String?
  configuration       Json?
  connectedAt         DateTime?           @db.Timestamptz(3)
  disconnectedAt      DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  conversations       Conversation[]

  @@unique([id, tenantId])
  @@unique([tenantId, provider, externalAccountId])
  @@index([tenantId, status])
}

model CommercialPlan {
