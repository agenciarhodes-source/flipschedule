generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db { provider = "postgresql" }

enum UserStatus { ACTIVE SUSPENDED DISABLED }
enum TenantStatus { ACTIVE SUSPENDED ARCHIVED }
enum ClinicStatus { ACTIVE INACTIVE }
enum MembershipRole { OWNER MANAGER RECEPTIONIST PROFESSIONAL AGENCY_LEAD AGENCY_OPS AGENCY_READONLY }
enum MembershipStatus { INVITED ACTIVE SUSPENDED REVOKED }
enum EntitlementType { TRIAL PAID COURTESY INTERNAL }
enum EntitlementStatus { ACTIVE EXPIRED REVOKED }
enum ProfessionalStatus { ACTIVE INACTIVE }
enum ResourceType { CHAIR ROOM EQUIPMENT OTHER }
enum ConsentPurpose { SERVICE APPOINTMENT_REMINDER MARKETING DATA_PROCESSING PUBLIC_TREATMENT_PLAN }
enum LegalBasis { CONSENT CONTRACT LEGAL_OBLIGATION LEGITIMATE_INTEREST HEALTH_PROTECTION }
enum PipelineStageType { OPEN WON LOST }
enum AppointmentStatus { SCHEDULED CONFIRMED ARRIVED ATTENDED NO_SHOW CANCELLED RESCHEDULED }
enum TreatmentPlanStatus { DRAFT SENT VIEWED ACCEPTED REJECTED EXPIRED CANCELLED }
enum ConversationChannel { WHATSAPP INSTAGRAM MESSENGER EMAIL INTERNAL }
enum ConversationStatus { OPEN PENDING CLOSED ARCHIVED }
enum MessageDirection { INBOUND OUTBOUND INTERNAL }
enum MessageStatus { PENDING SENT DELIVERED READ FAILED RECEIVED }
enum IntegrationProvider { WHATSAPP INSTAGRAM MESSENGER FACEBOOK_LEADS ASAAS EMAIL }
enum IntegrationStatus { DISCONNECTED PENDING CONNECTED ERROR REVOKED }
enum BillingProvider { ASAAS MANUAL }
enum SubscriptionStatus { PENDING ACTIVE PAST_DUE SUSPENDED CANCELLED EXPIRED }
enum PaymentStatus { PENDING CONFIRMED RECEIVED OVERDUE REFUNDED CANCELLED FAILED }
enum WebhookStatus { RECEIVED PROCESSING PROCESSED FAILED }
enum AuditOutcome { SUCCESS DENIED FAILED }

model User {
 id String @id @default(uuid()) @db.Uuid
 emailNormalized String @unique
 displayName String
 status UserStatus @default(ACTIVE)
 emailVerifiedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 memberships Membership[]
 entitlementsGranted AccessEntitlement[]
 auditLogs AuditLog[]
}
model Tenant {
 id String @id @default(uuid()) @db.Uuid
 name String
 slug String @unique
 status TenantStatus @default(ACTIVE)
 timezone String
 locale String @default("pt-BR")
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 clinics Clinic[]
 memberships Membership[]
 entitlements AccessEntitlement[]
 professionals Professional[]
 resources Resource[]
 procedures Procedure[]
 workingHours WorkingHours[]
 scheduleBlocks ScheduleBlock[]
 patients Patient[]
 consents Consent[]
 pipelines Pipeline[]
 pipelineStages PipelineStage[]
 leads Lead[]
 leadStageHistories LeadStageHistory[]
 patientAttributions PatientAttribution[]
 appointments Appointment[]
 appointmentStatusHistories AppointmentStatusHistory[]
 treatmentPlans TreatmentPlan[]
 treatmentPlanItems TreatmentPlanItem[]
 treatmentPlanStatusHistories TreatmentPlanStatusHistory[]
 conversations Conversation[]
 messages Message[]
 integrations Integration[]
 subscriptions Subscription[]
 payments Payment[]
 webhookEvents WebhookEvent[]
 auditLogs AuditLog[]
}
model Clinic {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 slug String
 timezoneOverride String?
 status ClinicStatus @default(ACTIVE)
 addressMetadata Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 professionalClinics ProfessionalClinic[]
 resources Resource[]
 scheduleBlocks ScheduleBlock[]
 leads Lead[]
 appointments Appointment[]
 treatmentPlans TreatmentPlan[]
 @@unique([id, tenantId])
 @@unique([tenantId, slug])
 @@index([tenantId, status])
}
model Membership {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 userId String @db.Uuid
 role MembershipRole
 status MembershipStatus @default(INVITED)
 invitedAt DateTime @default(now()) @db.Timestamptz(3)
 acceptedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 user User @relation(fields:[userId], references:[id])
 professionals Professional[]
 blocksCreated ScheduleBlock[]
 leadsAssigned Lead[]
 leadChanges LeadStageHistory[]
 appointmentsCreated Appointment[]
 appointmentChanges AppointmentStatusHistory[]
 treatmentPlansCreated TreatmentPlan[]
 treatmentPlanChanges TreatmentPlanStatusHistory[]
 auditLogs AuditLog[]
 @@unique([tenantId, userId])
 @@unique([id, tenantId])
 @@index([userId, status])
}
model AccessEntitlement {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 type EntitlementType
 status EntitlementStatus
 startsAt DateTime @db.Timestamptz(3)
 endsAt DateTime? @db.Timestamptz(3)
 reason String?
 grantedByUserId String? @db.Uuid
 revokedAt DateTime? @db.Timestamptz(3)
 metadata Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 grantedBy User? @relation(fields:[grantedByUserId], references:[id])
 @@unique([id, tenantId])
 @@index([tenantId, status, startsAt])
}
model Professional {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 membershipId String? @db.Uuid
 name String
 specialty String
 registrationNumber String?
 registrationRegion String?
 status ProfessionalStatus @default(ACTIVE)
 color String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 membership Membership? @relation(fields:[membershipId,tenantId], references:[id,tenantId])
 clinics ProfessionalClinic[]
 scheduleBlocks ScheduleBlock[]
 treatmentPlans TreatmentPlan[]
 @@unique([id, tenantId])
 @@index([membershipId, tenantId])
}
model ProfessionalClinic {
 tenantId String @db.Uuid
 professionalId String @db.Uuid
 clinicId String @db.Uuid
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 professional Professional @relation(fields:[professionalId,tenantId], references:[id,tenantId])
 clinic Clinic @relation(fields:[clinicId,tenantId], references:[id,tenantId])
 workingHours WorkingHours[]
 appointments Appointment[]
 @@id([tenantId, professionalId, clinicId])
}
model Resource {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 clinicId String @db.Uuid
 name String
 type ResourceType
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 clinic Clinic @relation(fields:[clinicId,tenantId], references:[id,tenantId])
 scheduleBlocks ScheduleBlock[]
 appointments Appointment[]
 @@unique([id, tenantId])
 @@index([clinicId, tenantId, active])
}
model Procedure {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 category String?
 durationMinutes Int
 defaultPriceCents Int
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
