model TreatmentPlan {
  id                    String                       @id @default(uuid()) @db.Uuid
  tenantId              String                       @db.Uuid
  clinicId              String?                      @db.Uuid
  patientId             String                       @db.Uuid
  professionalId        String?                      @db.Uuid
  leadId                String?                      @db.Uuid
  createdByMembershipId String?                      @db.Uuid
  title                 String
  status                TreatmentPlanStatus          @default(DRAFT)
  subtotalCents         Int
  discountCents         Int                          @default(0)
  totalCents            Int
  publicTokenHash       String?                      @unique
  publicTokenExpiresAt  DateTime?                    @db.Timestamptz(3)
  sentAt                DateTime?                    @db.Timestamptz(3)
  acceptedAt            DateTime?                    @db.Timestamptz(3)
  rejectedAt            DateTime?                    @db.Timestamptz(3)
  expiresAt             DateTime?                    @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(3)
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  clinic                Clinic?                      @relation(fields: [clinicId], references: [id])
  patient               Patient                      @relation(fields: [patientId], references: [id])
  professional          Professional?                @relation(fields: [professionalId], references: [id])
  lead                  Lead?                        @relation(fields: [leadId], references: [id])
  createdBy             Membership?                  @relation("TreatmentPlanCreatedBy", fields: [createdByMembershipId], references: [id])
  items                 TreatmentPlanItem[]
  statusHistory         TreatmentPlanStatusHistory[]

  @@unique([id, tenantId])
  @@index([tenantId, patientId, status])
}

model TreatmentPlanItem {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  treatmentPlanId String        @db.Uuid
  procedureId     String?       @db.Uuid
