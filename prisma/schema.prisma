  treatmentPlan         TreatmentPlan        @relation(fields: [treatmentPlanId], references: [id])
  changedBy             Membership?          @relation("TreatmentPlanStatusHistoryChangedBy", fields: [changedByMembershipId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, treatmentPlanId, changedAt])
