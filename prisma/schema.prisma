 treatmentPlanItems TreatmentPlanItem[]
 @@unique([id, tenantId])
 @@index([tenantId, active])
}
model WorkingHours {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 professionalId String @db.Uuid
 clinicId String @db.Uuid
 weekday Int
 startMinute Int
 endMinute Int
 validFrom DateTime? @db.Date
 validUntil DateTime? @db.Date
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 professionalClinic ProfessionalClinic @relation(fields:[tenantId,professionalId,clinicId], references:[tenantId,professionalId,clinicId])
 @@unique([id, tenantId])
 @@index([tenantId, professionalId, clinicId, weekday])
}
model ScheduleBlock {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 clinicId String? @db.Uuid
 professionalId String? @db.Uuid
 resourceId String? @db.Uuid
 startsAt DateTime @db.Timestamptz(3)
 endsAt DateTime @db.Timestamptz(3)
 reason String?
 createdByMembershipId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 clinic Clinic? @relation(fields:[clinicId,tenantId], references:[id,tenantId])
 professional Professional? @relation(fields:[professionalId,tenantId], references:[id,tenantId])
 resource Resource? @relation(fields:[resourceId,tenantId], references:[id,tenantId])
 createdBy Membership? @relation(fields:[createdByMembershipId,tenantId], references:[id,tenantId])
 @@unique([id, tenantId])
 @@index([tenantId, startsAt, endsAt])
}
model Patient {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 phoneE164 String?
 emailNormalized String?
 birthDate DateTime? @db.Date
 cpfCiphertext String?
 cpfHash String?
 notesCiphertext String?
 archivedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 consents Consent[]
 leads Lead[]
 attributions PatientAttribution[]
 appointments Appointment[]
 treatmentPlans TreatmentPlan[]
 conversations Conversation[]
 @@unique([id, tenantId])
 @@unique([tenantId, phoneE164])
 @@index([tenantId, emailNormalized])
}
model Consent {
 id String @id @default(uuid()) @db.Uuid
