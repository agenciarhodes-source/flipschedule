  status               PlatformOperatorStatus @default(ACTIVE)
  createdByUserId      String?                @db.Uuid
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  user                 User                   @relation("PlatformOperatorUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy            User?                  @relation("PlatformOperatorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  supportGrants        PlatformSupportGrant[] @relation("SupportGrantOperator")
  supportGrantsCreated PlatformSupportGrant[] @relation("SupportGrantCreatedBy")

  @@index([status, role])
}

model PlatformSupportGrant {
  id                  String           @id @default(uuid()) @db.Uuid
  operatorId          String           @db.Uuid
  tenantId            String           @db.Uuid
  reason              String
  expiresAt           DateTime         @db.Timestamptz(3)
  revokedAt           DateTime?        @db.Timestamptz(3)
