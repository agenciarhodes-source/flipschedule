model TransactionalEmailDelivery {
  id                   String                   @id @default(uuid()) @db.Uuid
  passwordResetTokenId String?                  @unique @db.Uuid
  kind                 TransactionalEmailKind
  provider             String
  providerMessageId    String?                  @unique
  idempotencyKey       String                   @unique
  recipientFingerprint String
  status               TransactionalEmailStatus @default(PENDING)
  failureCode          String?
  lastEventAt          DateTime?                @db.Timestamptz(3)
  sentAt               DateTime?                @db.Timestamptz(3)
  deliveredAt          DateTime?                @db.Timestamptz(3)
  delayedAt            DateTime?                @db.Timestamptz(3)
  bouncedAt            DateTime?                @db.Timestamptz(3)
  complainedAt         DateTime?                @db.Timestamptz(3)
