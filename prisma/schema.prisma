 leads Lead[]
 @@unique([id, tenantId])
 @@index([tenantId, active])
}
model PipelineStage {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 pipelineId String @db.Uuid
 name String
 position Int
 type PipelineStageType @default(OPEN)
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 pipeline Pipeline @relation(fields:[pipelineId,tenantId], references:[id,tenantId])
 currentLeads Lead[]
 historyFrom LeadStageHistory[] @relation("HistoryFromStage")
 historyTo LeadStageHistory[] @relation("HistoryToStage")
 @@unique([id, tenantId])
 @@unique([pipelineId, tenantId, position])
}
model Lead {
 id String @id @default(uuid()) @db.Uuid
