  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdByOperator   PlatformOperator @relation("SupportGrantCreatedBy", fields: [createdByOperatorId], references: [id], onDelete: Restrict)

  @@index([operatorId, tenantId, expiresAt])
  @@index([tenantId, revokedAt, expiresAt])
}

model WebhookEvent {
