generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformOperatorRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SUPPORT
  BILLING
  READONLY
}

enum PlatformOperatorStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClinicStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  OWNER
  MANAGER
  RECEPTIONIST
  PROFESSIONAL
  AGENCY_LEAD
  AGENCY_OPS
  AGENCY_READONLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum EntitlementType {
  TRIAL
  PAID
  COURTESY
  INTERNAL
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
}

enum ResourceType {
  CHAIR
  ROOM
  EQUIPMENT
  OTHER
}

enum ConsentPurpose {
  SERVICE
  APPOINTMENT_REMINDER
  MARKETING
  DATA_PROCESSING
  PUBLIC_TREATMENT_PLAN
}

enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  HEALTH_PROTECTION
}

enum PipelineStageType {
  OPEN
  WON
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  ATTENDED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum TreatmentPlanStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  EMAIL
  INTERNAL
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum IntegrationProvider {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  FACEBOOK_LEADS
  ASAAS
  EMAIL
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum BillingProvider {
  ASAAS
  MANUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  CANCELLED
  FAILED
}

enum BillingCheckoutStatus {
  CREATED
  ACTIVE
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum CommercialPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommercialPlanCycle {
  MONTHLY
  YEARLY
  CUSTOM
}

enum TransactionalEmailKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum TransactionalEmailStatus {
  PENDING
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

model User {
  id                       String               @id @default(uuid()) @db.Uuid
  emailNormalized          String               @unique
  displayName              String
  status                   UserStatus           @default(ACTIVE)
  emailVerified            Boolean              @default(false)
  emailVerifiedAt          DateTime?            @db.Timestamptz(3)
  mustChangePassword       Boolean              @default(false)
  passwordChangedAt        DateTime?            @db.Timestamptz(3)
  firstAccessCompletedAt   DateTime?            @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  memberships              Membership[]
  entitlementsGranted      AccessEntitlement[]  @relation("AccessEntitlementGrantedBy")
  auditLogs                AuditLog[]           @relation("AuditLogActorUser")
  authSessions             AuthSession[]
  authAccounts             AuthAccount[]
  authVerifications        AuthVerification[]
  passwordResetTokens      PasswordResetToken[]
  invitationsAccepted      TenantInvitation[]   @relation("TenantInvitationAcceptedBy")
  platformOperator         PlatformOperator?    @relation("PlatformOperatorUser")
  platformOperatorsCreated PlatformOperator[]   @relation("PlatformOperatorCreatedBy")
}

model PasswordResetToken {
  id                         String                      @id @default(uuid()) @db.Uuid
  userId                     String                      @db.Uuid
  purpose                    String
  tokenHash                  String                      @unique
  expiresAt                  DateTime                    @db.Timestamptz(3)
  consumedAt                 DateTime?                   @db.Timestamptz(3)
  revokedAt                  DateTime?                   @db.Timestamptz(3)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionalEmailDelivery TransactionalEmailDelivery?

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([purpose, expiresAt])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([providerId])
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  userId     String?  @db.Uuid
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
}

model Tenant {
  id                           String                       @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String                       @unique
  status                       TenantStatus                 @default(ACTIVE)
  timezone                     String
  locale                       String                       @default("pt-BR")
  createdAt                    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                     @updatedAt @db.Timestamptz(3)
  clinics                      Clinic[]
  memberships                  Membership[]
  entitlements                 AccessEntitlement[]
  professionals                Professional[]
  resources                    Resource[]
  procedures                   Procedure[]
  workingHours                 WorkingHours[]
  scheduleBlocks               ScheduleBlock[]
  patients                     Patient[]
  consents                     Consent[]
  pipelines                    Pipeline[]
  pipelineStages               PipelineStage[]
  leads                        Lead[]
  leadStageHistories           LeadStageHistory[]
  patientAttributions          PatientAttribution[]
  appointments                 Appointment[]
  appointmentStatusHistories   AppointmentStatusHistory[]
  treatmentPlans               TreatmentPlan[]
  treatmentPlanItems           TreatmentPlanItem[]
  treatmentPlanStatusHistories TreatmentPlanStatusHistory[]
  conversations                Conversation[]
  messages                     Message[]
  integrations                 Integration[]
  subscriptions                Subscription[]
  payments                     Payment[]
  billingCheckouts             BillingCheckout[]
  webhookEvents                WebhookEvent[]
  securityRateLimitBuckets     SecurityRateLimitBucket[]
  auditLogs                    AuditLog[]
  invitations                  TenantInvitation[]
  platformSupportGrants        PlatformSupportGrant[]
}

model Clinic {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  name                String
  slug                String
  timezoneOverride    String?
  status              ClinicStatus         @default(ACTIVE)
  addressMetadata     Json?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  professionalClinics ProfessionalClinic[]
  resources           Resource[]
  scheduleBlocks      ScheduleBlock[]
  leads               Lead[]
  appointments        Appointment[]
  treatmentPlans      TreatmentPlan[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Membership {
  id                      String                       @id @default(uuid()) @db.Uuid
  tenantId                String                       @db.Uuid
  userId                  String                       @db.Uuid
  role                    MembershipRole
  status                  MembershipStatus             @default(INVITED)
  invitedAt               DateTime                     @default(now()) @db.Timestamptz(3)
  acceptedAt              DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)
  tenant                  Tenant                       @relation(fields: [tenantId], references: [id])
  user                    User                         @relation(fields: [userId], references: [id])
  professionals           Professional[]               @relation("ProfessionalMembership")
  blocksCreated           ScheduleBlock[]              @relation("ScheduleBlockCreatedBy")
  leadsAssigned           Lead[]                       @relation("LeadAssignedMembership")
  leadChanges             LeadStageHistory[]           @relation("LeadStageHistoryChangedBy")
  appointmentsCreated     Appointment[]                @relation("AppointmentCreatedBy")
  appointmentChanges      AppointmentStatusHistory[]   @relation("AppointmentStatusHistoryChangedBy")
  treatmentPlansCreated   TreatmentPlan[]              @relation("TreatmentPlanCreatedBy")
  treatmentPlanChanges    TreatmentPlanStatusHistory[] @relation("TreatmentPlanStatusHistoryChangedBy")
  auditLogs               AuditLog[]                   @relation("AuditLogActorMembership")
  invitationsSent         TenantInvitation[]           @relation("TenantInvitationInvitedBy")
  billingCheckoutsCreated BillingCheckout[]            @relation("BillingCheckoutCreatedBy")

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([userId, status])
}

model TenantInvitation {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  emailNormalized       String
  role                  MembershipRole
  tokenHash             String         @unique
  expiresAt             DateTime       @db.Timestamptz(3)
  acceptedAt            DateTime?      @db.Timestamptz(3)
  revokedAt             DateTime?      @db.Timestamptz(3)
  invitedByMembershipId String         @db.Uuid
  acceptedByUserId      String?        @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy             Membership     @relation("TenantInvitationInvitedBy", fields: [invitedByMembershipId], references: [id], onDelete: Restrict)
  acceptedBy            User?          @relation("TenantInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, emailNormalized])
  @@index([tenantId, acceptedAt, revokedAt, expiresAt])
  @@index([expiresAt])
}

model AccessEntitlement {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  type            EntitlementType
  status          EntitlementStatus
  startsAt        DateTime          @db.Timestamptz(3)
  endsAt          DateTime?         @db.Timestamptz(3)
  reason          String?
  grantedByUserId String?           @db.Uuid
  revokedAt       DateTime?         @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  grantedBy       User?             @relation("AccessEntitlementGrantedBy", fields: [grantedByUserId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, status, startsAt])
}

model Professional {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  membershipId       String?              @db.Uuid
  name               String
  specialty          String
  registrationNumber String?
  registrationRegion String?
  status             ProfessionalStatus   @default(ACTIVE)
  color              String?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  membership         Membership?          @relation("ProfessionalMembership", fields: [membershipId], references: [id])
  clinics            ProfessionalClinic[]
  scheduleBlocks     ScheduleBlock[]
  treatmentPlans     TreatmentPlan[]

  @@unique([id, tenantId])
  @@index([membershipId, tenantId])
}

model ProfessionalClinic {
  tenantId       String         @db.Uuid
  professionalId String         @db.Uuid
  clinicId       String         @db.Uuid
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  professional   Professional   @relation(fields: [professionalId], references: [id])
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  workingHours   WorkingHours[]
  appointments   Appointment[]

  @@id([tenantId, professionalId, clinicId])
  @@unique([professionalId, clinicId])
}

model Resource {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  clinicId       String          @db.Uuid
  name           String
  type           ResourceType
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  scheduleBlocks ScheduleBlock[]
  appointments   Appointment[]

  @@unique([id, tenantId])
  @@index([clinicId, tenantId, active])
}

model Procedure {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  name               String
  category           String?
  durationMinutes    Int
  defaultPriceCents  Int
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  appointments       Appointment[]
  treatmentPlanItems TreatmentPlanItem[]

  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model WorkingHours {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  professionalId     String             @db.Uuid
  clinicId           String             @db.Uuid
  weekday            Int
  startMinute        Int
  endMinute          Int
  validFrom          DateTime?          @db.Date
  validUntil         DateTime?          @db.Date
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  professionalClinic ProfessionalClinic @relation(fields: [professionalId, clinicId], references: [professionalId, clinicId])

  @@unique([id, tenantId])
  @@index([tenantId, professionalId, clinicId, weekday])
}

model ScheduleBlock {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @db.Uuid
  clinicId              String?       @db.Uuid
  professionalId        String?       @db.Uuid
  resourceId            String?       @db.Uuid
  startsAt              DateTime      @db.Timestamptz(3)
  endsAt                DateTime      @db.Timestamptz(3)
  reason                String?
  createdByMembershipId String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  clinic                Clinic?       @relation(fields: [clinicId], references: [id])
  professional          Professional? @relation(fields: [professionalId], references: [id])
  resource              Resource?     @relation(fields: [resourceId], references: [id])
  createdBy             Membership?   @relation("ScheduleBlockCreatedBy", fields: [createdByMembershipId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, startsAt, endsAt])
}

model Patient {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  name            String
  phoneE164       String?
  emailNormalized String?
  birthDate       DateTime?            @db.Date
  cpfCiphertext   String?
  cpfHash         String?
  notesCiphertext String?
  archivedAt      DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  consents        Consent[]
  leads           Lead[]
  attributions    PatientAttribution[]
  appointments    Appointment[]
  treatmentPlans  TreatmentPlan[]
  conversations   Conversation[]

  @@unique([id, tenantId])
  @@unique([tenantId, phoneE164])
  @@index([tenantId, emailNormalized])
}

model Consent {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  patientId     String         @db.Uuid
  purpose       ConsentPurpose
  legalBasis    LegalBasis
  policyVersion String
  policyHash    String
  granted       Boolean
  grantedAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  evidence      Json?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, patientId, purpose])
}

model Pipeline {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  name      String
  active    Boolean         @default(true)
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  stages    PipelineStage[]
  leads     Lead[]

  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model PipelineStage {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  pipelineId   String             @db.Uuid
  name         String
  position     Int
  type         PipelineStageType  @default(OPEN)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  pipeline     Pipeline           @relation(fields: [pipelineId], references: [id])
  currentLeads Lead[]
  historyFrom  LeadStageHistory[] @relation("HistoryFromStage")
  historyTo    LeadStageHistory[] @relation("HistoryToStage")

  @@unique([id, tenantId])
  @@unique([pipelineId, tenantId, position])
}

model Lead {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  clinicId             String?              @db.Uuid
  patientId            String?              @db.Uuid
  pipelineId           String               @db.Uuid
  stageId              String               @db.Uuid
  assignedMembershipId String?              @db.Uuid
  name                 String
  phoneE164            String?
  emailNormalized      String?
  estimatedValueCents  Int                  @default(0)
  source               String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  wonAt                DateTime?            @db.Timestamptz(3)
  lostAt               DateTime?            @db.Timestamptz(3)
  archivedAt           DateTime?            @db.Timestamptz(3)
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  clinic               Clinic?              @relation(fields: [clinicId], references: [id])
  patient              Patient?             @relation(fields: [patientId], references: [id])
  pipeline             Pipeline             @relation(fields: [pipelineId], references: [id])
  stage                PipelineStage        @relation(fields: [stageId], references: [id])
  assignedMembership   Membership?          @relation("LeadAssignedMembership", fields: [assignedMembershipId], references: [id])
  stageHistory         LeadStageHistory[]
  attributions         PatientAttribution[]
  appointments         Appointment[]
  treatmentPlans       TreatmentPlan[]
  conversations        Conversation[]

  @@unique([id, tenantId])
  @@index([tenantId, pipelineId, stageId])
}

model LeadStageHistory {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  leadId                String         @db.Uuid
  fromStageId           String?        @db.Uuid
  toStageId             String         @db.Uuid
  changedByMembershipId String?        @db.Uuid
  changedAt             DateTime       @default(now()) @db.Timestamptz(3)
  reason                String?
  tenant                Tenant         @relation(fields: [tenantId], references: [id])
  lead                  Lead           @relation(fields: [leadId], references: [id])
  fromStage             PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id])
  toStage               PipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id])
  changedBy             Membership?    @relation("LeadStageHistoryChangedBy", fields: [changedByMembershipId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, leadId, changedAt])
}

model PatientAttribution {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  patientId           String   @db.Uuid
  leadId              String?  @db.Uuid
  source              String?
  medium              String?
  campaign            String?
  content             String?
  term                String?
  platform            String?
  externalClickIdHash String?
  attributedAt        DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  patient             Patient  @relation(fields: [patientId], references: [id])
  lead                Lead?    @relation(fields: [leadId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, patientId, attributedAt])
}

model Appointment {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @db.Uuid
  clinicId              String                     @db.Uuid
  patientId             String                     @db.Uuid
  professionalId        String                     @db.Uuid
  procedureId           String?                    @db.Uuid
  resourceId            String?                    @db.Uuid
  leadId                String?                    @db.Uuid
  createdByMembershipId String?                    @db.Uuid
  startsAt              DateTime                   @db.Timestamptz(3)
  endsAt                DateTime                   @db.Timestamptz(3)
  status                AppointmentStatus          @default(SCHEDULED)
  priceCents            Int                        @default(0)
  notesCiphertext       String?
  cancellationReason    String?
  source                String?
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  tenant                Tenant                     @relation(fields: [tenantId], references: [id])
  professionalClinic    ProfessionalClinic         @relation(fields: [professionalId, clinicId], references: [professionalId, clinicId])
  clinic                Clinic                     @relation(fields: [clinicId], references: [id])
  patient               Patient                    @relation(fields: [patientId], references: [id])
  procedure             Procedure?                 @relation(fields: [procedureId], references: [id])
  resource              Resource?                  @relation(fields: [resourceId], references: [id])
  lead                  Lead?                      @relation(fields: [leadId], references: [id])
  createdBy             Membership?                @relation("AppointmentCreatedBy", fields: [createdByMembershipId], references: [id])
