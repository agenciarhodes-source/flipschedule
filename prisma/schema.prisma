 emailNormalized String?
 estimatedValueCents Int @default(0)
 source String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 wonAt DateTime? @db.Timestamptz(3)
 lostAt DateTime? @db.Timestamptz(3)
 archivedAt DateTime? @db.Timestamptz(3)
 tenant Tenant @relation(fields:[tenantId], references:[id])
 clinic Clinic? @relation(fields:[clinicId,tenantId], references:[id,tenantId])
 patient Patient? @relation(fields:[patientId,tenantId], references:[id,tenantId])
 pipeline Pipeline @relation(fields:[pipelineId,tenantId], references:[id,tenantId])
 stage PipelineStage @relation(fields:[stageId,tenantId], references:[id,tenantId])
 assignedMembership Membership? @relation(fields:[assignedMembershipId,tenantId], references:[id,tenantId])
 stageHistory LeadStageHistory[]
 attributions PatientAttribution[]
 appointments Appointment[]
 treatmentPlans TreatmentPlan[]
 conversations Conversation[]
 @@unique([id, tenantId])
 @@index([tenantId, pipelineId, stageId])
}
model LeadStageHistory {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 leadId String @db.Uuid
 fromStageId String? @db.Uuid
 toStageId String @db.Uuid
 changedByMembershipId String? @db.Uuid
 changedAt DateTime @default(now()) @db.Timestamptz(3)
 reason String?
 tenant Tenant @relation(fields:[tenantId], references:[id])
 lead Lead @relation(fields:[leadId,tenantId], references:[id,tenantId])
 fromStage PipelineStage? @relation("HistoryFromStage", fields:[fromStageId,tenantId], references:[id,tenantId])
 toStage PipelineStage @relation("HistoryToStage", fields:[toStageId,tenantId], references:[id,tenantId])
